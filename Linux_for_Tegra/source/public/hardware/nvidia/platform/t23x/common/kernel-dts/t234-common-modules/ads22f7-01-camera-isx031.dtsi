/ {
  tegra-capture-vi {
    num-channels = <4>;
    ports {
      #address-cells = <1>;
      #size-cells = <0>;
      port@0 {
        reg = <0>;
        liisx031_vi_in0: endpoint {
          vc-id = <0>;
          port-index = <4>;
          bus-width = <4>;
          remote-endpoint = <&liisx031_csi_out0>;
        };
      };
      port@1 {
        reg = <1>;
        liisx031_vi_in1: endpoint {
          vc-id = <1>;
          port-index = <4>;
          bus-width = <4>;
          remote-endpoint = <&liisx031_csi_out1>;
        };
      };
      port@2 {
        reg = <2>;
        liisx031_vi_in2: endpoint {
          vc-id = <2>;
          port-index = <4>;
          bus-width = <4>;
          remote-endpoint = <&liisx031_csi_out2>;
        };
      };
      port@3 {
        reg = <3>;
        liisx031_vi_in3: endpoint {
          vc-id = <3>;
          port-index = <4>;
          bus-width = <4>;
          remote-endpoint = <&liisx031_csi_out3>;
        };
      };
    };
  };

  host1x@13e00000 {
    nvcsi@15a00000 {
      num-channels = <4>;
      #address-cells = <1>;
      #size-cells = <0>;
      channel@0 {
        reg = <0>;
        ports {
          #address-cells = <1>;
          #size-cells = <0>;
          port@0 {
            reg = <0>;
            liisx031_csi_in0: endpoint@0 {
              port-index = <4>;
              bus-width = <4>;
              remote-endpoint = <&liisx031_isx031_out0>;
            };
          };
          port@1 {
            reg = <1>;
            liisx031_csi_out0: endpoint@1 {
              remote-endpoint = <&liisx031_vi_in0>;
            };
          };
        };
      };
      channel@1 {
        reg = <1>;
        ports {
          #address-cells = <1>;
          #size-cells = <0>;
          port@0 {
            reg = <0>;
            liisx031_csi_in1: endpoint@2 {
              port-index = <4>;
              bus-width = <4>;
              remote-endpoint = <&liisx031_isx031_out1>;
            };
          };
          port@1 {
            reg = <1>;
            liisx031_csi_out1: endpoint@3 {
              remote-endpoint = <&liisx031_vi_in1>;
            };
          };
        };
      };
      channel@2 {
        reg = <2>;
        ports {
          #address-cells = <1>;
          #size-cells = <0>;
          port@0 {
            reg = <0>;
            liisx031_csi_in2: endpoint@4 {
              port-index = <4>;
              bus-width = <4>;
              remote-endpoint = <&liisx031_isx031_out2>;
            };
          };
          port@1 {
            reg = <1>;
            liisx031_csi_out2: endpoint@5 {
              remote-endpoint = <&liisx031_vi_in2>;
            };
          };
        };
      };
      channel@3 {
        reg = <3>;
        ports {
          #address-cells = <1>;
          #size-cells = <0>;
          port@0 {
            reg = <0>;
            liisx031_csi_in3: endpoint@6 {
              port-index = <4>;
              bus-width = <4>;
              remote-endpoint = <&liisx031_isx031_out3>;
            };
          };
          port@1 {
            reg = <1>;
            liisx031_csi_out3: endpoint@7 {
              remote-endpoint = <&liisx031_vi_in3>;
            };
          };
        };
      };
    };
  };

  i2c@3180000 {
    isx031_a@31{
      compatible = "sony,isx031";
      reg = <0x31>;
      sensor_model ="isx031";
      mode0 {
        mclk_khz = "24000";
        num_lanes = "4";  // Or "4" if your module/board supports it for more headroom
        tegra_sinterface = "serial_e";
        phy_mode = "DPHY";
        vc_id = "0";
        discontinuous_clk = "no";
        dpcm_enable = "false";
        cil_settletime = "0";
        dynamic_pixel_bit_depth = "16";
        csi_pixel_bit_depth = "16";
        mode_type = "yuv";
        pixel_phase = "uyvy";

        active_w = "1920";
        active_h = "1536";  // ← Changed
        readout_orientation = "0";
        line_length = "1000";  // ← Changed for standard timings
        inherent_gain = "1";
        
        pix_clk_hz = "134400000";  // ← Changed to match standard 1080p30
        serdes_pix_clk_hz = "300000000";  // Keep if using GMSL2 deserializer

        gain_factor = "10";
        min_gain_val = "0";
        max_gain_val = "300";
        step_gain_val = "3";
        default_gain = "0";
        min_hdr_ratio = "1";
        max_hdr_ratio = "1";
        framerate_factor = "1000000";
		    min_framerate = "30000000";
		    max_framerate = "30000000";
		    step_framerate = "1";
		    default_framerate = "30000000";
		    exposure_factor = "1000000";
		    min_exp_time = "59"; /*us, 2 lines*/
		    max_exp_time = "33333";
		    step_exp_time = "1";
		    default_exp_time = "33333";/* us */
		    embedded_metadata_height = "0";
      };
      ports {
        #address-cells = <1>;
        #size-cells = <0>;
        port@0 {
          reg = <0>;
          liisx031_isx031_out0: endpoint {
            vc-id = <0>;
            port-index = <4>;
            bus-width = <4>;
            remote-endpoint = <&liisx031_csi_in0>;
          };
        };
      };
    };


    isx031_a@32{
      compatible = "sony,isx031";
      reg = <0x32>;
      sensor_model ="isx031";
      mode0 {
        mclk_khz = "24000";
        num_lanes = "4";  // Or "4" if your module/board supports it for more headroom
        tegra_sinterface = "serial_e";
        phy_mode = "DPHY";
        vc_id = "1";
        discontinuous_clk = "no";
        dpcm_enable = "false";
        cil_settletime = "0";
        dynamic_pixel_bit_depth = "16";
        csi_pixel_bit_depth = "16";
        mode_type = "yuv";
        pixel_phase = "uyvy";

        active_w = "1920";
        active_h = "1536";  // ← Changed
        readout_orientation = "0";
        line_length = "1000";  // ← Changed for standard timings
        inherent_gain = "1";
        
        pix_clk_hz = "134400000";  // ← Changed to match standard 1080p30
        serdes_pix_clk_hz = "300000000";  // Keep if using GMSL2 deserializer

        gain_factor = "10";
        min_gain_val = "0";
        max_gain_val = "300";
        step_gain_val = "3";
        default_gain = "0";
        min_hdr_ratio = "1";
        max_hdr_ratio = "1";
        framerate_factor = "1000000";
		    min_framerate = "30000000";
		    max_framerate = "30000000";
		    step_framerate = "1";
		    default_framerate = "30000000";
		    exposure_factor = "1000000";
		    min_exp_time = "59"; /*us, 2 lines*/
		    max_exp_time = "33333";
		    step_exp_time = "1";
		    default_exp_time = "33333";/* us */
		    embedded_metadata_height = "0";
      };
      ports {
        #address-cells = <1>;
        #size-cells = <0>;
        port@0 {
          reg = <0>;
          liisx031_isx031_out1: endpoint {
            vc-id = <1>;
            port-index = <4>;
            bus-width = <4>;
            remote-endpoint = <&liisx031_csi_in1>;
          };
        };
      };
    };


    isx031_a@33{
      compatible = "sony,isx031";
      reg = <0x33>;
      sensor_model ="isx031";
      mode0 {
        mclk_khz = "24000";
        num_lanes = "4";  // Or "4" if your module/board supports it for more headroom
        tegra_sinterface = "serial_e";
        phy_mode = "DPHY";
        vc_id = "2";
        discontinuous_clk = "no";
        dpcm_enable = "false";
        cil_settletime = "0";
        dynamic_pixel_bit_depth = "16";
        csi_pixel_bit_depth = "16";
        mode_type = "yuv";
        pixel_phase = "uyvy";

        active_w = "1920";
        active_h = "1536";  // ← Changed
        readout_orientation = "0";
        line_length = "1000";  // ← Changed for standard timings
        inherent_gain = "1";
        
        pix_clk_hz = "134400000";  // ← Changed to match standard 1080p30
        serdes_pix_clk_hz = "300000000";  // Keep if using GMSL2 deserializer

        gain_factor = "10";
        min_gain_val = "0";
        max_gain_val = "300";
        step_gain_val = "3";
        default_gain = "0";
        min_hdr_ratio = "1";
        max_hdr_ratio = "1";
        framerate_factor = "1000000";
		    min_framerate = "30000000";
		    max_framerate = "30000000";
		    step_framerate = "1";
		    default_framerate = "30000000";
		    exposure_factor = "1000000";
		    min_exp_time = "59"; /*us, 2 lines*/
		    max_exp_time = "33333";
		    step_exp_time = "1";
		    default_exp_time = "33333";/* us */
		    embedded_metadata_height = "0";
      };
      ports {
        #address-cells = <1>;
        #size-cells = <0>;
        port@0 {
          reg = <0>;
          liisx031_isx031_out2: endpoint {
            vc-id = <2>;
            port-index = <4>;
            bus-width = <4>;
            remote-endpoint = <&liisx031_csi_in2>;
          };
        };
      };
    };


    isx031_a@34{
      compatible = "sony,isx031";
      reg = <0x34>;
      sensor_model ="isx031";
      mode0 {
        mclk_khz = "24000";
        num_lanes = "4";  // Or "4" if your module/board supports it for more headroom
        tegra_sinterface = "serial_e";
        phy_mode = "DPHY";
        vc_id = "3";
        discontinuous_clk = "no";
        dpcm_enable = "false";
        cil_settletime = "0";
        dynamic_pixel_bit_depth = "16";
        csi_pixel_bit_depth = "16";
        mode_type = "yuv";
        pixel_phase = "uyvy";

        active_w = "1920";
        active_h = "1536";  // ← Changed
        readout_orientation = "0";
        line_length = "1000";  // ← Changed for standard timings
        inherent_gain = "1";
        
        pix_clk_hz = "134400000";  // ← Changed to match standard 1080p30
        serdes_pix_clk_hz = "300000000";  // Keep if using GMSL2 deserializer

        gain_factor = "10";
        min_gain_val = "0";
        max_gain_val = "300";
        step_gain_val = "3";
        default_gain = "0";
        min_hdr_ratio = "1";
        max_hdr_ratio = "1";
        framerate_factor = "1000000";
		    min_framerate = "30000000";
		    max_framerate = "30000000";
		    step_framerate = "1";
		    default_framerate = "30000000";
		    exposure_factor = "1000000";
		    min_exp_time = "59"; /*us, 2 lines*/
		    max_exp_time = "33333";
		    step_exp_time = "1";
		    default_exp_time = "33333";/* us */
		    embedded_metadata_height = "0";
      };
      ports {
        #address-cells = <1>;
        #size-cells = <0>;
        port@0 {
          reg = <0>;
          liisx031_isx031_out3: endpoint {
            vc-id = <3>;
            port-index = <4>;
            bus-width = <4>;
            remote-endpoint = <&liisx031_csi_in3>;
          };
        };
      };
    };
  };
};

/ {

	tegra-camera-platform {
		compatible = "nvidia, tegra-camera-platform";

		/**
		 * The general guideline for naming badge_info contains 3 parts, and is as follows,
		 * The first part is the camera_board_id for the module; if the module is in a FFD
		 * platform, then use the platform name for this part.
		 * The second part contains the position of the module, ex. "rear" or "front".
		 * The third part contains the last 6 characters of a part number which is found
		 * in the module's specsheet from the vender.
		 */
		modules {
			module0 {
				badge = "isx031_bottom_liisx031";
				position = "bottom";
				orientation = "0";
				drivernode0 {
					/* Declare PCL support driver (classically known as guid)  */
					pcl_id = "v4l2_sensor";
					/* Driver v4l2 device name */
					devname = "isx031 0-0031";
					/* Declare the device-tree hierarchy to driver instance */
					proc-device-tree = "/proc/device-tree/i2c@3180000/isx031_a@31";
				};
			};

      module1 {
				badge = "isx031_front_liisx031";
				position = "front";
				orientation = "0";
				drivernode0 {
					/* Declare PCL support driver (classically known as guid)  */
					pcl_id = "v4l2_sensor";
					/* Driver v4l2 device name */
					devname = "isx031 0-0032";
					/* Declare the device-tree hierarchy to driver instance */
					proc-device-tree = "/proc/device-tree/i2c@3180000/isx031_a@32";
				};
			};

      module2 {
				badge = "isx031_up_liisx031";
				position = "up";
				orientation = "0";
				drivernode0 {
					/* Declare PCL support driver (classically known as guid)  */
					pcl_id = "v4l2_sensor";
					/* Driver v4l2 device name */
					devname = "isx031 0-0033";
					/* Declare the device-tree hierarchy to driver instance */
					proc-device-tree = "/proc/device-tree/i2c@3180000/isx031_a@33";
				};
			};

      module3 {
				badge = "isx031_back_liisx031";
				position = "back";
				orientation = "0";
				drivernode0 {
					/* Declare PCL support driver (classically known as guid)  */
					pcl_id = "v4l2_sensor";
					/* Driver v4l2 device name */
					devname = "isx031 0-0034";
					/* Declare the device-tree hierarchy to driver instance */
					proc-device-tree = "/proc/device-tree/i2c@3180000/isx031_a@34";
				};
			};
		};
	};
};