#include <t234-common-modules/ads22f7-01-camera-irs2877a.dtsi>


/* camera control gpio definitions */

/ {
	/*i2c 0*/
	i2c@3160000 {
				irs2877a_a@3d {
					def-addr = <0x3d>;
				};
				
				sz220at_b@30 {
					def-addr = <0x30>;
				};
	};
};
